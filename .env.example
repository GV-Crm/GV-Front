# Copia a .env.development / .env.production. En Vercel se define como variable del proyecto.
# URL del backend (GV-Back), sin / al final.
VITE_API_URL=https://gv-back.vercel.app
# Proyecto de Supabase (mismos valores que NEXT_PUBLIC_SUPABASE_* del backend). La anon key es pública.
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
